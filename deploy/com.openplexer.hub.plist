<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.openplexer.hub</string>
	<key>UserName</key>
	<string>REPLACE_WITH_HUB_USER</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/openplexer-hub</string>
		<string>serve</string>
		<string>-data-dir</string>
		<string>/var/lib/openplexer</string>
		<string>-listen</string>
		<string>127.0.0.1:8787</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/lib/openplexer/hub.log</string>
</dict>
</plist>
