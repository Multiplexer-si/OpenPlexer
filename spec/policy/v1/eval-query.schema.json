{
  "$id": "urn:openplexer:spec:policy:v1:eval-query",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The request that the policy evaluator answers. Authored from a type of the reference.",
  "if": {
    "properties": {
      "action": {
        "const": "exec"
      }
    },
    "required": [
      "action"
    ]
  },
  "properties": {
    "action": {
      "description": "The action to evaluate.",
      "enum": [
        "read",
        "write",
        "exec",
        "git.push"
      ],
      "type": "string"
    },
    "agent_session_id": {
      "description": "The agent session that asks.",
      "type": "string"
    },
    "command": {
      "description": "The command line for `exec`.",
      "type": "string"
    },
    "member": {
      "description": "The id of the member that the agent acts for.",
      "type": "string"
    },
    "mission_id": {
      "description": "The mission of that agent session.",
      "type": "string"
    },
    "now": {
      "description": "The time of the evaluation. The evaluator reads no clock.",
      "format": "date-time",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$",
      "type": "string"
    },
    "overrides": {
      "description": "The overrides that are active for the caller.",
      "items": {
        "$ref": "urn:openplexer:spec:policy:v1:override"
      },
      "type": "array"
    },
    "parent": {
      "additionalProperties": false,
      "description": "Present for a sub-agent. Overrides and temporary grants then match the session and the mission of the parent.",
      "properties": {
        "agent_session_id": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        }
      },
      "required": [
        "agent_session_id"
      ],
      "type": "object"
    },
    "path": {
      "description": "The file path for `read` and `write`. `exec` and `git.push` ignore it.",
      "type": "string"
    },
    "repo": {
      "description": "The repository that the action is in. `exec` ignores it.",
      "type": "string"
    }
  },
  "required": [
    "repo",
    "path",
    "action",
    "member",
    "now"
  ],
  "then": {
    "required": [
      "command"
    ]
  },
  "title": "Evaluation query",
  "type": "object"
}
