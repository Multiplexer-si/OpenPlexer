      "input": {
        "actions": [
          "delete"
        ],
        "agent_session_id": "ses-1",
        "area": "billing",
        "id": "ovr-1",
        "scope": "once"
      },
      "name": "an unknown action is invalid",
      "why": "`actions` holds only the four actions of the policy contract."
    },
    {
      "expected": {
        "valid": true
      },
      "input": {
        "actions": [],
        "agent_session_id": "ses-1",
        "area": "billing",
        "id": "ovr-1",
        "scope": "once"
      },
      "name": "an empty list of actions is valid",
      "why": "The schema sets no minimum length for `actions`."
    },
    {
      "expected": {
        "valid": false
      },
      "informational": {
        "reason": "id: Invalid input: expected string, received undefined"
      },
      "input": {
        "actions": [
          "write"
        ],
        "agent_session_id": "ses-1",
        "area": "billing",
        "scope": "once"
      },
      "name": "a missing id is invalid",
      "why": "`id` is required."
    },
    {
      "expected": {
