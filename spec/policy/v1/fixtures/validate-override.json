{
  "cases": [
    {
      "expected": {
        "valid": true
      },
      "input": {
        "actions": [
          "write"
        ],
        "agent_session_id": "ses-1",
        "area": "billing",
        "id": "ovr-1",
        "scope": "once"
      },
      "name": "an override with scope once is valid",
      "why": "`id`, `area`, `actions`, and `scope` are required."
    },
    {
      "expected": {
        "valid": true
      },
      "input": {
        "actions": [
          "write"
        ],
        "area": "billing",
        "id": "ovr-1",
        "scope": "once"
      },
      "name": "an override with scope once and no session is valid",
      "why": "The schema does not require the field that the scope needs. The evaluator treats such an override as inactive."
    },
    {
      "expected": {
        "valid": true
      },
      "input": {
        "actions": [
          "write"
        ],
        "agent_session_id": "ses-1",
        "area": "billing",
        "expires_at": "not a timestamp",
        "id": "ovr-1",
        "scope": "once"
      },
      "name": "an expires_at that is not a timestamp is valid",
      "why": "`expires_at` is any string. The evaluator treats an unreadable expiry as inactive."
    },
    {
      "expected": {
        "valid": false
      },
      "informational": {
        "reason": "scope: Invalid option: expected one of \"once\"|\"mission\"|\"until\""
      },
      "input": {
        "actions": [
          "write"
        ],
        "agent_session_id": "ses-1",
        "area": "billing",
        "id": "ovr-1",
        "scope": "forever"
      },
      "name": "an unknown scope is invalid",
      "why": "`scope` is `once`, `mission`, or `until`."
    },
    {
      "expected": {
        "valid": false
      },
      "informational": {
        "reason": "actions.0: Invalid option: expected one of \"read\"|\"write\"|\"exec\"|\"git.push\""
