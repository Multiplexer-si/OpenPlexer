{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "description": "What the implementation must return. Compare the whole value."
        },
        "informational": {
          "description": "Output of the reference that an implementation need not reproduce, such as the wording of a message.",
          "type": "object"
        },
        "input": {
          "description": "What the implementation receives."
        },
        "name": {
          "description": "Unique in the file.",
          "minLength": 1,
          "type": "string"
        },
        "why": {
          "description": "The behavior that the case pins.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "why",
        "input",
        "expected"
      ],
      "type": "object"
    }
  },
  "$id": "urn:openplexer:spec:fixture-file",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "evaluate"
          }
        },
        "required": [
