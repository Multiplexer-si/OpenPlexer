                "informational": false,
                "input": {
                  "additionalProperties": false,
                  "properties": {
                    "json": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "json"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "contract": {
            "enum": [
              "canonical-json"
