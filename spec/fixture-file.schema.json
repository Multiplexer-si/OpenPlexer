              }
            }
          },
          "contract": {
            "enum": [
              "policy"
            ]
          },
          "schema": false,
          "shared": {
            "additionalProperties": false,
            "properties": {
              "bundle": {
                "$ref": "urn:openplexer:spec:policy:v1:bundle"
              }
            },
            "required": [
              "bundle"
            ],
            "type": "object"
          }
        },
        "required": [
          "shared"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "validate"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
