                "informational": {
                  "additionalProperties": false,
                  "properties": {
                    "hash_inputs": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "hash_inputs"
                  ],
                  "type": "object"
                },
                "input": {
                  "additionalProperties": false,
                  "properties": {
                    "records": {
                      "items": {
                        "$ref": "urn:openplexer:spec:audit:v1:record"
