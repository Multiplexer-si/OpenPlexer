          "operation"
        ]
      },
      "then": {
        "description": "Parse the JSON text in `input.json` and write the value as canonical JSON.",
        "properties": {
          "cases": {
            "items": {
              "properties": {
                "expected": {
                  "additionalProperties": false,
                  "properties": {
                    "canonical": {
                      "type": "string"
