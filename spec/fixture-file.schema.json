  "description": "A list of cases for one operation of one contract. Each case pairs an input with the result that the reference gives.",
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/case"
      },
      "minItems": 1,
      "type": "array"
    },
    "contract": {
      "description": "The contract directory that the file belongs to.",
      "enum": [
        "policy",
        "room",
        "audit",
        "canonical-json"
      ]
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "operation": {
      "description": "What an implementation does with each case.",
      "enum": [
        "evaluate",
        "validate",
        "patterns-overlap",
        "path-sets-overlap",
        "canonicalize",
        "verify-chain",
        "verify-signed-bundle"
      ]
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "description": "The commit of the existing TypeScript implementation that produced the expected values.",
          "pattern": "^[0-9a-f]{8}$",
          "type": "string"
        },
        "sources": {
          "description": "The files of that implementation that the cases exercise, relative to its root.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "commit",
        "sources"
      ],
      "type": "object"
    },
    "schema": {
      "description": "For `validate`: the `$id` of the schema under test.",
      "type": "string"
    },
    "shared": {
      "description": "Input that every case of the file shares.",
      "type": "object"
    },
    "version": {
      "const": 1,
      "description": "The version of the contract."
    }
  },
  "required": [
    "contract",
    "version",
    "operation",
    "description",
    "reference",
    "cases"
  ],
  "title": "Fixture file",
  "type": "object"
}
