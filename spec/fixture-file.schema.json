          "operation"
        ]
      },
      "then": {
        "description": "Decide whether any pattern of one claim overlaps any pattern of another claim.",
        "properties": {
          "cases": {
            "items": {
              "properties": {
                "expected": {
                  "additionalProperties": false,
                  "properties": {
                    "overlap": {
                      "type": "boolean"
                    }
                  },
                  "required": [
