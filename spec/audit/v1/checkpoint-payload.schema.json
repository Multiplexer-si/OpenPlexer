{
  "$id": "urn:openplexer:spec:audit:v1:checkpoint-payload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit checkpoint payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "workspace_id": {
      "type": "string",
      "description": "The workspace whose records the hub signed."
    },
    "entries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Record count, measured from genesis."
    },
    "tip_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash at that count, or 64 zeros at count zero."
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{3}|0[1-9][0-9]{2}|00[1-9][0-9]|000[1-9])-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "The hub issue time, in UTC with milliseconds."
    }
  },
  "required": [
    "v",
    "workspace_id",
    "entries",
    "tip_hash",
    "issued_at"
  ]
}
