{
    "model": "opus",
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "say done"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash|Edit|NotebookEdit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/local/bin/openplexer hook claude-code pre-tool",
                        "timeout": 5,
                        "onFailure": "block"
                    }
                ]
            }
        ]
    },
    "includeCoAuthoredBy": false
}
