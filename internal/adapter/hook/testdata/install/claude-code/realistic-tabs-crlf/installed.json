{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": ["Bash(git status)", "Read(~/notes/caf\u00e9.md)"],
		"defaultMode": "acceptEdits"
	},

	"env": {
		"RATIO": 1.0,
		"BIG": 1e3,
		"NAME": "caf\u00e9"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "/usr/local/bin/audit-bash.sh",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Bash|Edit|NotebookEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "/usr/local/bin/openplexer hook claude-code pre-tool",
						"timeout": 5,
						"onFailure": "block"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write",
				"hooks": [
					{
						"type": "command",
						"command": "gofmt -w ."
					}
				]
			}
		]
	},
	"cleanupPeriodDays": 20
}